SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=life_rpg
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Optional: enable real password-reset emails in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@yourdomain.com
# Only for local development when SMTP is not configured
RESET_EXPOSE_LINK=true
